APP_NAME="ChamberQ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: APP_URL=https://your-real-domain (never localhost — SMS ticket links use this)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_EXPIRE_ON_CLOSE=false
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# No re-authentication prompts: password-confirmation window, in seconds.
AUTH_PASSWORD_TIMEOUT=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Dhaka

# Comma-separated hosts for marketing + Super Admin (not tenant chambers).
# Local/dev defaults; production: yourdomain.com,www.yourdomain.com
CENTRAL_DOMAINS=127.0.0.1,localhost

# Central sales landing page (wa.me digits, BD country code)
MARKETING_PRODUCT_NAME="ChamberQ"
MARKETING_WHATSAPP=8801700000000
MARKETING_PHONE=01700000000
MARKETING_SOLO_SETUP=15000
MARKETING_SOLO_MONTHLY=3000
MARKETING_CLINIC_SETUP=75000
MARKETING_CLINIC_MONTHLY=7500
MARKETING_SMS_CREDIT_PRICE=0.50

# SMS gateway (prepaid wallet). Default "log" never hits the network.
SMS_DRIVER=log
SMS_ENABLED=true
# SMS_HTTP_URL=
# SMS_HTTP_API_KEY=
# SMS_HTTP_SENDER=
