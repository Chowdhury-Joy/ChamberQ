*.log
.DS_Store
# Finder's custom folder-icon file. Its real name ends in a carriage return,
# which git cannot match literally here — the `?` stands in for that byte.
Icon?
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
# Local QA sweep output. Machine-specific run artefacts, and they carry whatever
# names and phone numbers the sweep happened to walk past.
/storage/qa-*.json
# Per-tenant storage roots. stancl/tenancy suffixes storage_path() with
# `tenant` + the tenant id (config/tenancy.php `suffix_base`), so every tenant —
# including every one a test creates — gets a directory here holding that
# practice's voice notes and prescription photos. Patient clinical records never
# belong in git, even synthetic ones.
/storage/tenant*
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
/.firecrawl/

# Machine-wide agent protocol, symlinked from ~/AGENTS.md (not machine-portable)
/AGENTS.md

# Local agent/tooling config
.claude/

# Build-time extract of macOS Helvetica Neue for slide font embedding (do not commit)
/docs/slides/.font-cache/
