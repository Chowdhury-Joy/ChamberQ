<?php

namespace App\Http\Controllers;

use App\Services\PrescriptionDictationService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;

class PrescriptionDictationController extends Controller
{
    public function extract(Request $request, PrescriptionDictationService $dictation): JsonResponse
    {
        $user = $request->user();

        if (! $user?->canRecordVisitNotes() || ! $user->belongsToCurrentTenant()) {
            abort(403);
        }

        $validated = $request->validate([
            'transcript' => ['required', 'string', 'min:3', 'max:8000'],
            'language' => ['nullable', 'string', 'in:bn-BD,en-US'],
        ]);

        $draft = $dictation->extract(
            $validated['transcript'],
            $validated['language'] ?? 'bn-BD',
            $user,
        );

        return response()->json($draft);
    }
}
